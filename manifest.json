{
  "manifest_version": 3,
  "name": "Bilibili Preference Plugin",
  "short_name": "Bili Preference",
  "version": "3.0.0",
  "description": "本地管理 B 站推荐：内容过滤、兴趣画像、探索和偏好配置。",
  "minimum_chrome_version": "121",
  "permissions": ["storage"],
  "host_permissions": ["https://api.bilibili.com/*"],
  "background": {
    "service_worker": "src/background.js",
    "scripts": ["src/core.js", "src/background.js"]
  },
  "content_scripts": [
    {
      "matches": ["https://www.bilibili.com/*"],
      "js": ["src/core.js", "src/content.js"],
      "css": ["src/content.css"],
      "run_at": "document_idle"
    }
  ],
  "action": {
    "default_title": "Bilibili Preference",
    "default_popup": "src/popup.html",
    "default_icon": {"16": "assets/icon16.png", "32": "assets/icon32.png"}
  },
  "options_ui": {"page": "src/dashboard.html", "open_in_tab": true},
  "icons": {"16": "assets/icon16.png", "48": "assets/icon48.png", "128": "assets/icon128.png"},
  "browser_specific_settings": {
    "gecko": {"id": "bilibili-preference@extension.local", "strict_min_version": "121.0"}
  }
}
