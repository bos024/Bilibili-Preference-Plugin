{
  "manifest_version": 3,
  "name": "B站兴趣画像与推荐算法控制",
  "version": "2.0",
  "description": "收集B站浏览行为，生成兴趣画像，支持历史偏好切换和直接更改推荐算法，破除信息茧房。",
  "permissions": [
    "storage", 
    "tabs", 
    "scripting",
    "activeTab"
  ],
  "host_permissions": [
    "https://www.bilibili.com/*",
    "https://search.bilibili.com/*"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "action": {
    "default_popup": "popup.html",
    "default_title": "B站推荐控制"
  },
  "content_scripts": [
    {
      "matches": ["https://www.bilibili.com/*"],
      "js": ["content.js"],
      "run_at": "document_end"
    }
  ],
  "web_accessible_resources": [
    {
      "resources": ["injected.js"],
      "matches": ["https://www.bilibili.com/*"]
    }
  ],
  "browser_specific_settings": {
    "gecko": {
      "id": "bilibili-preference@example.com",
      "strict_min_version": "109.0"
    }
  }
} 